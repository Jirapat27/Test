# Copy to .env and fill in. NEVER commit .env.

# paper   = fake fills, market data from Settrade (sandbox or live creds)
# sandbox = Settrade sandbox (UAT) -- simulated exchange, no real money
# live    = REAL MONEY. Also requires THAITRADER_CONFIRM_LIVE=yes
THAITRADER_MODE=sandbox
THAITRADER_CONFIRM_LIVE=no

# From your broker's Settrade Open API registration.
# For sandbox use BROKER_ID=SANDBOX and APP_CODE=SANDBOX.
SETTRADE_APP_ID=
SETTRADE_APP_SECRET=
SETTRADE_APP_CODE=SANDBOX
SETTRADE_BROKER_ID=SANDBOX
SETTRADE_ACCOUNT_NO=
SETTRADE_PIN=

# Risk limits (THB)
RISK_MAX_ORDER_VALUE=50000
RISK_MAX_POSITION_VALUE=100000
RISK_MAX_DAILY_LOSS=5000
RISK_MAX_ORDERS_PER_DAY=20

# Optional alerts (leave blank to only log)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
